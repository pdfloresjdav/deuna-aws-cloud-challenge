# Copy to backend.hcl and fill with values from the bootstrap outputs, then:
#   terraform init -backend-config=backend.hcl
# Do NOT commit backend.hcl (it is git-ignored).

bucket       = "deuna-terraform-state-REPLACE-WITH-UNIQUE-SUFFIX"
key          = "env/dev/terraform.tfstate"
region       = "us-east-1"
encrypt      = true
kms_key_id   = "arn:aws:kms:us-east-1:111122223333:key/REPLACE-WITH-STATE-KEY-ID"
use_lockfile = true
